{
  "name": "flight-metar",
  "config": {
    "connector.class": "HttpSource",
    "name": "flight-metar",
    "tasks.max": "1",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "${KAFKA_API_KEY}",
    "kafka.api.secret": "${KAFKA_API_SECRET}",
    "output.data.format": "JSON",
    "url": "https://aviationweather.gov/api/data/metar?ids=KORD,KSFO,KJFK&format=json",
    "topic.name.pattern": "metar_raw",
    "http.request.method": "GET",
    "auth.type": "none",
    "http.offset.mode": "SIMPLE_INCREMENTING",
    "http.initial.offset": "0",
    "request.interval.ms": "60000",
    "transforms": "keep",
    "transforms.keep.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.keep.include": "icaoId,rawOb,fltCat,visib,cover,name,temp,dewp,obsTime,lat,lon"
  }
}